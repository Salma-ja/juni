DATABASE_URL=postgresql://localhost:5432/juni
JUNI_DEMO_LOGIN_ENABLED=true
# PORT=3000

# Map tiles (optional). Default is OpenStreetMap's keyless public server: fine for a demo, not for production traffic.
# To use a provider with a key, set both and rebuild (npm run build:web). Placeholders: {z} {x} {y}.
# EXPO_PUBLIC_MAP_TILE_URL=https://api.maptiler.com/maps/streets-v2/256/{z}/{x}/{y}.png?key=YOUR_KEY
# EXPO_PUBLIC_MAP_CREDIT=© MapTiler © OpenStreetMap contributors

# Developer demo strip (switch rider/captain, reset seed) above the app. Off by default.
# EXPO_PUBLIC_SHOW_DEMO_BAR=true
